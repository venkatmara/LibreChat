# Persistence module selection: mongo | postgres (default stays mongo until cutover)
PERSISTENCE_MODULE=mongo
# PostgreSQL
DATABASE_URL=postgres://app_user:change-me@localhost:5432/librechat
PG_POOL_MAX=10
PG_SSL_MODE=disable
# MongoDB (Mongo adapter and lcmig extract)
MONGO_URI=mongodb://localhost:27017/LibreChat
