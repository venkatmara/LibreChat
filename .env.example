# Persistence module selection: mongo (default until cutover) | postgres
PERSISTENCE_MODULE=mongo
# PostgreSQL (placeholders only; never commit real credentials)
DATABASE_URL=postgres://lcmig_app:change-me@localhost:5432/lcmig
PG_POOL_MAX=10
PG_SSL_MODE=disable
# MongoDB (Mongo adapter and the lcmig migrator)
MONGO_URI=mongodb://localhost:27017/LibreChat
