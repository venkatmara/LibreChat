{
  "name": "lcmig",
  "version": "0.1.0",
  "private": true,
  "description": "LCMIG: LibreChat MongoDB to PostgreSQL persistence layer and migration tooling",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/lcmig",
    "packages/persistence-core",
    "packages/persistence-mongo",
    "packages/persistence-postgres"
  ],
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.check.json",
    "audit:check": "tsc -b && node packages/lcmig/dist/cli.js audit-check",
    "test": "jest"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.0",
    "eslint": "^9.12.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0"
  }
}
